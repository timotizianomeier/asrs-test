---
// The frame every page sits in (like geotastic's templates/base.html).
import { getMessages, type Locale } from "../i18n";
import { REPO_URL } from "../site";
import "../styles/global.css";

interface Props {
  title: string;
  locale: Locale;
  description?: string;
}

const { title, locale, description } = Astro.props;
const t = getMessages(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} – {t.siteName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <a class="skip-link" href="#content">{t.skipToContent}</a>
    <!-- Remove at go-live (docs/decisions.md #18). -->
    <p class="test-banner">{t.testBanner}</p>

    <header>
      <a href="/">{t.siteName}</a>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer>
      <p><strong>{t.notADiagnosis}</strong></p>
      <p>{t.footer.help}</p>
      <p>{t.footer.asrsCopyright}</p>
      <p><a href={REPO_URL}>{t.footer.codeLink}</a></p>
    </footer>
  </body>
</html>
